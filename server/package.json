{
  "name": "eari-sync-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "eari-sync-server": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "start": "node dist/index.js",
    "init": "node dist/cli.js init",
    "doctor": "node dist/cli.js doctor",
    "backup": "node dist/cli.js backup",
    "restore": "node dist/cli.js restore",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eari-sync/shared": "*",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  }
}
